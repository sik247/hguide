<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declared: only what the app actually uses. No pleos.car.permission.CONTROL_* (see docs/pleos-api-notes.md). -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />      <!-- Brake pedal, Gear (read) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />     <!-- TurnSignal (read) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" /> <!-- FusedLocation, proximity alerts -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />     <!-- family-mode recording (consent-gated) -->
    <uses-permission android:name="android.permission.INTERNET" />         <!-- STT/TTS server mode, LLM vendor -->

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".HguideApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:targetApi="34">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
